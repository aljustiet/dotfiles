# -*- mode: conf-space -*-

# Dark theme: Pure Black background with Red text
set default-bg "#000000"
set default-fg "#FF0000"

set recolor true
set recolor-reverse-video false
set recolor-lightcolor "#000000"
set recolor-darkcolor "#FF0000"

set inputbar-bg "#000000"
set inputbar-fg "#FF0000"
set statusbar-bg "#000000"
set statusbar-fg "#FF0000"

set completion-bg "#000000"
set completion-fg "#FF0000"
set completion-group-bg "#000000"
set completion-group-fg "#FF0000"
set completion-highlight-bg "#FF0000"
set completion-highlight-fg "#000000"

set notification-bg "#000000"
set notification-fg "#FF0000"
set notification-error-bg "#FF0000"
set notification-error-fg "#000000"
set notification-warning-bg "#FF0000"
set notification-warning-fg "#000000"

set index-bg "#000000"
set index-fg "#FF0000"
set index-active-bg "#FF0000"
set index-active-fg "#000000"
