{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "right",

  "modules-left": [
    "niri/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio#icon",
    "pulseaudio#text",
    "battery#icon",
    "battery#text",
    "tray"
  ],

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "justify": "center"
  },

  "cpu": {
    "interval": 1,
  },

  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%d.%m.%Y %A}",
  },

  "pulseaudio#icon": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "on-click-right": "amixer -q sset Master toggle",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },

  "pulseaudio#text": {
    "format": "{volume}",
    "format-muted": "0"
  },

  "battery#text": {
    "format": "{capacity}"
  },

  "battery#icon": {
    "format": "{icon}",
    "format-charging": "⚡",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "tray": {
    "icon-size": 20,
    "spacing": 8
  },
  "temperature#cpu": {
    "hwmon-path": "/sys/class/hwmon/hwmon7/temp1_input",
    "interval": 1,
    "format": "󰻠 󰔄\n{temperatureC}",
    "justify": "center"
  },
  "temperature#nvme": {
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp3_input",
    "critical-threshold": 70,
    "interval": 1,
    "format": "\n{temperatureC}",
    "justify": "center"
  },
  "cpu": {
    "format": "󰻠\n{load}",
    "justify": "center"
  },
}
