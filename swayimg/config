[general]
mode = viewer

size = 1720,960

[viewer]
window = #000000FF
transparency = #000000FF
scale = fit
# resize_reset = no
#slideshow = no
history = 1
preload = 1

[gallery]

[list]
order = none
#loop = no
recursive = no
all = no

[font]
name = GoMono Nerd Font
size = 16
color = #0F319D

[info]
show = no
info_timeout = 0
status_timeout = 5

[keys.viewer]
d = zoom height
w = zoom width

bracketright = zoom +10
bracketleft = zoom -10
Shift+bracketright = zoom 50
Shift+bracketleft = zoom -50
s = flip_vertical
Shift+s = flip_horizontal

9 = rotate_left
0 = rotate_right
r = rotate_left
Shift+r = rotate_right
f = fullscreen
escape = fullscreen
q = exit
h = step_left
a = step_down
e = step_up
i = step_right
Shift+h = step_left 50
Shift+a = step_down 50
Shift+e = step_up 50
Shift+i = step_right 50

n = antialiasing
Shift+n = antialiasing prev

x = next_file
p = prev_file
o = info off,viewer

space = animation
comma = next_frame
period = prev_frame

[keys.gallery]
w = zoom fit
y = next_file
g = prev_file

[keys.slideshow]
w = zoom fit
y = next_file
g = prev_file
